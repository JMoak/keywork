# `box init` copies this file to .env. It holds what every box shares: team settings and
# secrets. What differs per repo (path, uid, tool versions) lives in boxes/<name>.env, which
# `box init` writes for you. Both are gitignored, and nothing else in agentbox holds a secret.

# ---- the team's choices ----
KEYWORK_VERSION=v0.1.1
# Systems to switch on, comma separated. Each name is a directory under systems/.
# Add `web` to let the agent read web pages; systems/web/compose.yaml says what that costs.
COMPOSE_PROFILES=github,jira
# bedrock/<model id or inference profile id>
AGENT_MODEL=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Any Debian or Ubuntu based image, for example the one your repo's .devcontainer uses.
BASE_IMAGE=debian:bookworm-slim

# Per repo, in boxes/<name>.env:
#   TOOLS=node@22.11 python@3.12          toolchains built into the image, as mise names them
#   APT_PACKAGES=postgresql-client        system packages, installed at build time
#   GATE_EXTRA_DOMAINS=docs.example.com   allowed on top of gate/allowed-domains.txt
#   GITHUB_REPOS=acme/api|acme/web        repos the agent may push to

# ---- agent container: Amazon Bedrock ----
# The one credential the agent holds today; VERIFY.md says why and what removes it.
AWS_REGION=us-east-1
# `box aws` fills the next three from this profile, and again whenever they expire.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- systems/github only (the MCP server and the git broker) ----
# Fine-grained token limited to the repos your boxes name in GITHUB_REPOS:
# contents, pull requests, and issues read/write, metadata read.
GITHUB_TOKEN=

# ---- systems/jira only ----
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=
JIRA_API_TOKEN=
